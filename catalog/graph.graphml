      <data key="n2">Literature search, systematic reviews, citation management and reference managers</data>
    </node>
    <node id="category:ideation-and-design">
      <data key="n0">category</data>
      <data key="n1">ideation-and-design</data>
      <data key="n2">Hypothesis generation, experimental design, statistics planning, validation</data>
    </node>
    <node id="category:data-science-and-ml">
      <data key="n0">category</data>
      <data key="n1">data-science-and-ml</data>
      <data key="n2">Data analysis, statistics and machine learning libraries</data>
