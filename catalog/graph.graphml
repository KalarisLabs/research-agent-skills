  <key id="n0" for="node" attr.name="type" attr.type="string"/>
  <key id="n1" for="node" attr.name="label" attr.type="string"/>
  <key id="n2" for="node" attr.name="description" attr.type="string"/>
  <key id="n3" for="node" attr.name="category" attr.type="string"/>
  <key id="n4" for="node" attr.name="path" attr.type="string"/>
  <key id="e5" for="edge" attr.name="type" attr.type="string"/>
  <graph id="research-agent-skills" edgedefault="directed">
    <node id="category:research-writing">
      <data key="n0">category</data>
      <data key="n1">research-writing</data>
      <data key="n2">Scientific and research paper writing, grants, peer review, critical appraisal</data>
    </node>
    <node id="category:journal-formats">
      <data key="n0">category</data>
      <data key="n1">journal-formats</data>
      <data key="n2">Journal, conference and venue formatting: LaTeX templates, submission checklists</data>
    </node>
    <node id="category:literature-review">
      <data key="n0">category</data>
