+    identifier: str | None,
+    path: str,
+    seen: set[str],
+    label: str,
+    errors: list[dict[str, str]],
+) -> None:
+    """Record a duplicate-ID error and remember the identifier."""
+    if identifier is None:
+        return
+    if identifier in seen:
+        errors.append(_issue(path, f"duplicate {label} ID"))
+    seen.add(identifier)
+
